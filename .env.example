SECRET_KEY=change-me-to-a-random-value

# Optional: configure these to actually send reset emails via SMTP.
# If MAIL_SERVER is left blank, the app logs the reset link to the console
# instead (and shows it in a flash message) so the flow still works locally.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=
